@page
@model RecipeApp.Pages.Recipes.CreateModel
@{
    ViewData["Title"] = "Create Recipe";
}

<h2>@ViewData["Title"]</h2>
<hr />

<form method="post" class="form-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.Name" class="control-label col-md-2"></label>
        <div class="col-md-10">
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Input.Category" class="control-label col-md-2">หมวดหมู่อาหาร</label>
        <div class="col-md-10">
            <select asp-for="Input.Category" class="form-control">
                <option value="ของคาว">ของคาว</option>
                <option value="ของหวาน">ของหวาน</option>
                <option value="ของทานเล่น">ของทานเล่น</option>
                <option value="ผัก/มังสวิรัติ">ผัก/มังสวิรัติ</option>
                <option value="เครื่องดื่ม">เครื่องดื่ม</option>
            </select>
            <span asp-validation-for="Input.Category" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Input.TimeToCookHrs" class="control-label col-md-2"></label>
        <div class="col-md-10">
            <input asp-for="Input.TimeToCookHrs" class="form-control" />
            <span asp-validation-for="Input.TimeToCookHrs" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Input.TimeToCookMins" class="control-label col-md-2"></label>
        <div class="col-md-10">
            <input asp-for="Input.TimeToCookMins" class="form-control" />
            <span asp-validation-for="Input.TimeToCookMins" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Input.Method" class="control-label col-md-2"></label>
        <div class="col-md-10">
            <textarea asp-for="Input.Method" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Input.Method" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <div class="checkbox">
                <label>
                    <input asp-for="Input.IsVegetarian" /> @Html.DisplayNameFor(m => m.Input.IsVegetarian)
                </label>
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <div class="checkbox">
                <label>
                    <input asp-for="Input.IsVegan" /> @Html.DisplayNameFor(m => m.Input.IsVegan)
                </label>
            </div>
        </div>
    </div>

    <hr />

    <div class="form-group">
        <table class="table table-striped" id="ingredients">
            <thead>
                <tr>
                    <th>Ingredient</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Input.Ingredients.Count; i++)
                {
                    <tr>
                        <td>
                            <input asp-for="Input.Ingredients[i].Name" class="form-control" />
                            <span asp-validation-for="Input.Ingredients[i].Name" class="text-danger"></span>
                        </td>
                        <td>
                            <input asp-for="Input.Ingredients[i].Quantity" class="form-control" />
                            <span asp-validation-for="Input.Ingredients[i].Quantity" class="text-danger"></span>
                        </td>
                        <td>
                            <input asp-for="Input.Ingredients[i].Unit" class="form-control" />
                            <span asp-validation-for="Input.Ingredients[i].Unit" class="text-danger"></span>
                        </td>
                        <td>
                            <a href="#" class="remove">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="button" class="btn btn-success" id="addIngredient">Add ingredient</button>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var ingredients = $('#ingredients tbody');
        $("#addIngredient").click(function () {
            var rowNo = ingredients.find('tr').length;
            var template =
                '<tr>' +
                '<td><input name="Input.Ingredients[' + rowNo + '].Name" id="Input_Ingredients_' + rowNo + '_Name" class="form-control" /></td>' +
                '<td><input name="Input.Ingredients[' + rowNo + '].Quantity" id="Input_Ingredients_' + rowNo + '_Quantity" class="form-control" /></td>' +
                '<td><input name="Input.Ingredients[' + rowNo + '].Unit" id="Input_Ingredients_' + rowNo + '_Unit" class="form-control" /></td>' +
                '<td><a href="#" class="remove">Remove</a></td>' +
                '</tr>';
            ingredients.append(template);
        });

        ingredients.on('click', '.remove', function (e) {
            e.preventDefault();
            $(this).closest('tr').remove();
        });
    </script>
}